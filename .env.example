# Supabase local (enterprise-control-platform isolated ports — see docs/LOCAL_SETUP.md)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56001
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose via NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Riyadh
NEXT_PUBLIC_DEFAULT_CURRENCY=SAR
NEXT_PUBLIC_DEFAULT_FINANCIAL_YEAR_START_MONTH=1

# Local database direct URL for integration tests (optional)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56002/postgres
